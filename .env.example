# Copy this file to .env. Never commit real client credentials.
AI_QA_TEST_USER_EMAIL=tester@example.com
AI_QA_TEST_USER_PASSWORD=replace-me

# Public SauceDemo portfolio persona shown on its login page.
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

# Standard names exposed by the generic manual GitHub audit workflow.
AI_QA_USERNAME=
AI_QA_PASSWORD=

# Fixed synthetic accounts for the controlled local authentication sandbox.
AUTH_SANDBOX_MEMBER_USERNAME=member@example.test
AUTH_SANDBOX_MEMBER_PASSWORD=member-pass
AUTH_SANDBOX_ADMIN_USERNAME=admin@example.test
AUTH_SANDBOX_ADMIN_PASSWORD=admin-pass
AUTH_SANDBOX_LOCKED_USERNAME=locked@example.test
AUTH_SANDBOX_LOCKED_PASSWORD=locked-pass

# Fixed synthetic bearer token for the controlled local API/workflow sandbox.
WORKFLOW_SANDBOX_API_TOKEN=workflow-sandbox-token
